node_modules/
dist/
build/

# Environment
.env

# Session files (contain credentials/tokens)
.ant_session.json
.kite_session.json
.breeze_session.json
.bulkpcr_armed_slots.json
# Catch-all for any other broker session/token/credential file (not just the names above)
.*_session*.json
*_session*.json
*token*.json
*.token
*credentials*.json

# Log files
*.log

# Lock files
.claude/scheduled_tasks.lock
.~lock.*

# IDE/Editor files
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*.iml

# ANT contract masters (large, re-downloaded from v2api.aliceblueonline.com/restpy/static/contract_master/V2/)
data/ant/*_contract.json*

# Temporary/generated files
tmp/
.tmp/
*.csv
public/
output.csv

# Broker contract-master download backups (scripts/download-all-masters.sh)
*.bak-*

# Runtime state and credentials (read by code, never committed)
userToken.txt
cert.pem
key.pem
.bulkpcr_armed_slots.*.json
.topStockOptionsOpeningGap_firedToday.*.json
debug.log
debug.txt
server_logs*.txt
requestOtp*
