# Copy this file to .env and fill in real values. .env is gitignored - never
# commit real secrets. Loaded automatically (via `dotenv/config`) by
# src/server.ts and src/orchestrator.ts - covers every process, since
# orchestrator.ts spawns order/data/strategies/frontend as children that
# inherit its already-populated process.env. See CLAUDE.md's Environment
# section for more detail on each of these.

# ---- Required - the server refuses to start without these ----

# Session cookie signing secret. Generate with: openssl rand -hex 32
SESSION_COOKIE_SECRET=

# Google OAuth client ID used to verify ID tokens on login (google-auth-library's
# verifyIdToken). Must exactly match frontend/.env's VITE_GOOGLE_CLIENT_ID -
# same public client ID, not a secret.
GOOGLE_CLIENT_ID=

# ---- Recommended (has a fallback default, but override for your own setup) ----

# Comma-separated emails granted the 'admin' role on account creation.
# Default: skarthikeyan100@gmail.com
ADMIN_EMAILS=

# HTTP port for the frontend/API server (also always listens on 80/443
# regardless of this value - see server.ts).
# Default: 3000
PORT=

# ---- Infra/dev - defaults are fine for a normal single-machine setup ----

# Path to the strategy/risk config YAML.
# Default: ./config.yml
CONFIG_PATH=

# Unix domain socket paths for the order/strategies IPC channels (see
# src/ipc/orderProtocol.ts, src/ipc/strategiesProtocol.ts). Only worth
# changing if running multiple instances on the same machine.
# Defaults: /tmp/icici-order.sock, /tmp/icici-strategies.sock
ORDER_IPC_SOCKET=
STRATEGIES_IPC_SOCKET=

# Timeout (ms) for a single order-process IPC request before OrderClient
# gives up and throws.
# Default: 90000
ORDER_IPC_TIMEOUT_MS=

# orchestrator.ts dev convenience - set to 'false' to disable auto-restarting
# a child process when its compiled output changes.
# Default: on (anything other than the literal string 'false')
HOT_RESTART=

# ---- Test/mock mode only - do not set for real trading ----

# 'true' to use MockAPI instead of the real Shoonya/Prism broker.
MOCK_BROKER=

# 'true' to also mock subscribe/quotes (Option B); false = real quotes, mock
# orders only (Option A). Only meaningful when MOCK_BROKER=true.
MOCK_QUOTES=

# Date (YYYY-MM-DD) to replay historical quotes from when mocking.
# Default: 2026-03-02
MOCK_DATE=
