    "objects-to-csv": "^1.3.6",
    "p-limit": "^3.1.0",
    "pdf-parse": "^1.1.1",
    "pdf.js-extract": "^0.2.1",
    "pdf2json": "^3.0.5",
    "pdf2table": "^0.0.2",
