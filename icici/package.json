{
  "name": "icici",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start1": "nodemon -r esm index.js",
    "start": "tsc-watch --onSuccess \"node ./dist/index.js\"",
    "adhoc": "tsc-watch --onSuccess \"node ./dist/decision.js\"",
    "server": "tsc-watch --onSuccess \"sh -c 'node ./dist/server.js 2>&1 | tee server.log'\"",
    "server:mock": "PORT=3001 MOCK_DATE=2026-02-24 MOCK_BROKER=true MOCK_QUOTES=true CONFIG_PATH=./config.mock.yml node ./dist/server.js 2>&1 | tee server.log",
    "server:mock:run": "PORT=3001 MOCK_BROKER=true MOCK_QUOTES=true CONFIG_PATH=./config.mock.yml node ./dist/server.js 2>&1 | tee server.log",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:strategy": "tsc && node ./dist/test/strategyTest.js",
    "analysis": "cd analysis && python3 main.py",
    "analyze": "tsc && node ./dist/tools/analyze.js",
    "analyze:check": "tsc && node ./dist/tools/check_indicators.js",
    "analyze:focused": "tsc && node ./dist/tools/analyze.js --indicators RSI_5_80_20,EMA_30_70 --threshold 10 --stopLoss 5",
    "analyze:scan": "tsc && node ./dist/tools/analyze.js",
    "pipeline": "tsc && node ./dist/tools/pipeline.js",
    "pipeline:combos": "tsc && node ./dist/tools/pipeline.js --combinations",
    "pipeline:fast": "tsc && node ./dist/tools/pipeline.js --thresholds 5,10,15,20 --indicators RSI_5_90_10",
    "pipeline:full": "tsc && node ./dist/tools/pipeline.js --reverseRsi --combinations",
    "momentum:fetch": "tsc && node ./dist/momentum/fetchDaily.js",
    "momentum:rank": "tsc && node ./dist/momentum/weeklyMomentum.js",
    "migrate:actualDay": "tsc && node ./dist/tools/migrate_actualDay.js",
    "sr:hypothesis": "tsc && node ./dist/tools/SupportResistanceHypothesisTest.js",
    "migrate-data": "ts-node ./scripts/migrateData.ts",
    "sentiment": "tsc && node ./dist/tools/sentiment.js",
    "sentiment:slow": "tsc && node ./dist/tools/sentiment.js --concurrency 2 --delay 2500",
    "logs": "tail -f server.log",
    "logs:errors": "tail -f server.log | grep -i error"
  },
  "author": "",
  "license": "ISC",
