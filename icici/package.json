    "@types/regression": "^2.0.6",
    "@types/request": "^2.48.8",
    "@types/socket.io": "^2.1.10",
    "async": "^3.2.4",
    "async-await-queue": "^1.2.0",
    "axios": "^0.27.2",
    "breezeconnect": "^1.0.29",
    "cheerio": "^1.0.0-rc.12",
    "cookie-parser": "^1.4.7",
    "cron": "^3.1.6",
    "crypto-js": "^4.1.1",
    "csv-parse": "^5.4.0",
    "csv-parser": "^2.3.5",
